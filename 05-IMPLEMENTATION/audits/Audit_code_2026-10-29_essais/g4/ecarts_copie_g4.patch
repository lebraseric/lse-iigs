+    essai_f_lister++;
     composer(c, e, NULL);
     op.pCount = 3;
     op.pathname = gs(c);
diff -ru src/plateforme/memoire_iigs.c copie/src/plateforme/memoire_iigs.c
--- src/plateforme/memoire_iigs.c	2026-10-29 11:37:00.105431058 +0100
+++ copie/src/plateforme/memoire_iigs.c	2026-10-29 14:18:59.405549846 +0100
@@ -18,6 +18,12 @@
 
 segment "objets";
 
+/* ESSAI G4 : compteurs d'appels (copie d'audit seulement). */
+unsigned long essai_nb_alloc = 0;
+unsigned long essai_nb_liberer = 0;
+unsigned long essai_nb_verrou = 0;
+unsigned long essai_nb_deverrou = 0;
+
 /* Un bloc de 64 Kio au plus est alloué sans franchir de frontière de banque
    (attrNoCross) : un objet reste ainsi dans une seule banque du 65816. Au-delà
    (objets hors-norme de très grande taille), ce n'est pas possible. */
@@ -29,6 +35,7 @@
     Handle h;
     Word attributs;
 
+    essai_nb_alloc++;
     attributs = attrNoPurge | attrNoSpec;
     if (taille_octets <= TAILLE_MAX_SANS_FRANCHISSEMENT)
         attributs |= attrNoCross;
@@ -40,17 +47,20 @@
 
 void plateforme_bloc_liberer(HandlePlateforme h)
 {
+    essai_nb_liberer++;
     DisposeHandle((Handle) h);
 }
 
 unsigned char *plateforme_bloc_verrouiller(HandlePlateforme h)
 {
+    essai_nb_verrou++;
     HLock((Handle) h);
     return *(unsigned char **) h;
 }
 
 void plateforme_bloc_deverrouiller(HandlePlateforme h)
 {
+    essai_nb_deverrou++;
     HUnlock((Handle) h);
 }
 
